<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Marks Table</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f5ff;
            padding: 20px;
        }

        h1 {
            text-align: center;
            color: #173b70;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th, td {
            border: 1px solid #555;
            padding: 12px;
            text-align: center;
        }

        th {
            background: #173b70;
            color: white;
        }

        tr:nth-child(even) {
            background: #e8eef8;
        }
    </style>
</head>

<body>
    <h1>Student Marks Table</h1>

    <table>
        <tr>
            <th>Roll No.</th>
