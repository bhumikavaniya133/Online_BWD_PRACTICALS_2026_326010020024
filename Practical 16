<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Practical 16 - Marks Calculator</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #eaf2f8;
            padding: 20px;
        }

        .container {
            max-width: 450px;
            margin: 20px auto;
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 0 10px #cccccc;
        }

        h1 {
            text-align: center;
            color: #154360;
        }

        label {
            display: block;
            margin-top: 15px;
        }

        input {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            box-sizing: border-box;
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background: #2874a6;
            color: white;
            border: none;
            cursor: pointer;
        }

        #result {
            margin-top: 20px;
            font-weight: bold;
            line-height: 1.8;
        }
    </style>
</head>

<body>

    <div class="container">
        <h1>Marks Calculator</h1>

        <label for="subject1">Subject 1 Marks (out of 100):</label>
        <input type="number" id="subject1" min="0" max="100">

        <label for="subject2">Subject 2 Marks (out of 100):</label>
        <input type="number" id="subject2" min="0" max="100">

        <label for="subject3">Subject 3 Marks (out of 100):</label>
        <input type="number" id="subject3" min="0" max="100">

        <label for="subject4">Subject 4 Marks (out of 100):</label>
        <input type="number" id="subject4" min="0" max="100">

        <label for="subject5">Subject 5 Marks (out of 100):</label>
        <input type="number" id="subject5" min="0" max="100">

        <button onclick="calculateMarks()">Calculate Result</button>

        <div id="result"></div>
    </div>

    <script>
        function calculateMarks() {
            let total = 0;

            for (let i = 1; i <= 5; i++) {
                let input = document.getElementById("subject" + i);
                let marks = input.value;

                if (marks === "" || Number(marks) < 0 ||
                    Number(marks) > 100) {
                    document.getElementById("result").innerHTML =
                        "Please enter marks between 0 and 100 for all subjects.";
                    return;
                }

                total += Number(marks);
            }

            let percentage = total / 5;

            document.getElementById("result").innerHTML =
                "Total Marks: " + total + " / 500<br>" +
                "Percentage: " + percentage.toFixed(2) + "%";
        }
    </script>

</body>
</html>
